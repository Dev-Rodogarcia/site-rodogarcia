# Desenvolvimento local Rodogarcia. Copie para .env.development.local.
# O iniciar-dev.bat fixa NODE_ENV=development e as portas 4012/4013/5012/5013.

ADMIN_SETUP_CODE=altere-para-um-codigo-local
SESSION_SECRET=altere-para-um-segredo-local-com-mais-de-32-caracteres

# CMS separado no desenvolvimento. CMS_INTERNAL_URL, CMS_BACKEND_INTERNAL_URL e
# CMS_BACKEND_PROXY_URL sao privados;
# NEXT_PUBLIC_SITE_URL e publico e serve somente links/previews do site no navegador.
# O iniciar-dev.bat aplica estes mesmos valores e permite 5013 apenas para testes diretos do CMS.
CMS_INTERNAL_URL=http://127.0.0.1:5013
CMS_BACKEND_INTERNAL_URL=http://127.0.0.1:4013
CMS_BACKEND_PROXY_URL=http://127.0.0.1:4013
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:5012
CORS_ORIGINS=http://127.0.0.1:5013,http://localhost:5013

# Landing Builder opcional, iniciado em fluxo separado de iniciar-dev.bat.
# Configure estas variaveis somente para integrar uma instancia independente; o token deve ser igual ao definido no backend dele.
# LANDING_BUILDER_API_URL=http://127.0.0.1:6110
# LANDING_BUILDER_SERVICE_TOKEN=altere-para-um-segredo-local-com-mais-de-32-caracteres
# LANDING_BUILDER_PUBLIC_URL=http://127.0.0.1:5112
# LANDING_BUILDER_ASSET_PREFIX=/landing-assets

# Integração privada com o TMS ESL Cloud. Não exponha esta chave ao frontend.
# GRAPHQL_API_KEY=cole-o-token-bearer-gerado-no-TMS-ESL
# Opcional em desenvolvimento: sem ele o backend usa segredo efêmero e as
# capabilities de coleta expiram ao reiniciar o processo.
# ESL_OPERATION_SECRET=altere-para-um-segredo-local-com-32-caracteres-ou-mais
# ESL_TENANT=rodogarcia
# ESL_GRAPHQL_URL=https://rodogarcia.eslcloud.com.br/graphql

# Opcional: o iniciar-dev.bat usa sempre o storage local do repositorio.
# Nao aponte este ambiente para o volume de producao.
# Opcional: sobrescreve o FFmpeg empacotado pelo backend para converter uploads de vídeo em WebM.
# FFMPEG_PATH=ffmpeg
