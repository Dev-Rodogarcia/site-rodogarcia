# Desenvolvimento local
PORT=5010
NODE_ENV=development

# Obrigatorio para cadastro inicial da primeira conta admin
ADMIN_SETUP_CODE=altere-para-um-codigo-forte

# Opcional (somente dev): permite iniciar sem ADMIN_SETUP_CODE e gerar codigo temporario no console
ALLOW_INSECURE_DEV_SETUP=false

# Opcional: caminho do store de usuarios (padrao: server/storage/private/users.json)
# USERS_STORE_PATH=server/storage/private/users.json

# Opcional: caminhos de conteudo/textos (padrao: server/storage/content.json e server/storage/site-texts.json)
# CONTENT_STORE_PATH=server/storage/content.json
# SITE_TEXTS_STORE_PATH=server/storage/site-texts.json

# Opcional: caminhos dos arquivos do Exit Intent Popup
# POPUP_CONFIG_STORE_PATH=server/storage/popup-config.json
# POPUP_LEADS_STORE_PATH=server/storage/popup-leads.json
# POPUP_EVENTS_STORE_PATH=server/storage/popup-events.json

# Opcional: caminhos dos arquivos do analytics proprio
# ANALYTICS_STORE_PATH=data/analytics.json
# ANALYTICS_CONFIG_PATH=data/analytics-config.json
