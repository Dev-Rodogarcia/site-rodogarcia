# Desenvolvimento local
PORT=5010
NODE_ENV=development

# Obrigatório para cadastro inicial da primeira conta admin
ADMIN_SETUP_CODE=altere-para-um-codigo-forte

# Opcional: caminho do store de usuários
# USERS_STORE_PATH=server/storage/private/users.json

# Opcional: caminhos de conteúdo/textos
# CONTENT_STORE_PATH=server/storage/content.json
# SITE_TEXTS_STORE_PATH=server/storage/site-texts.json

# Opcional: stores de formulários
# CONTACTS_STORE_PATH=server/storage/contacts.json
# QUOTES_STORE_PATH=server/storage/quotes.json

# Opcional: caminhos dos arquivos do popup
# POPUP_CONFIG_STORE_PATH=server/storage/popup-config.json
# POPUP_LEADS_STORE_PATH=server/storage/popup-leads.json
# POPUP_EVENTS_STORE_PATH=server/storage/popup-events.json

# Opcional: stores privados
# SESSIONS_STORE_PATH=server/storage/private/sessions.json
# ANALYTICS_STORE_PATH=server/storage/private/analytics.json
# ANALYTICS_CONFIG_PATH=server/storage/private/analytics-config.json
# RATE_LIMITS_STORE_PATH=server/storage/private/rate-limits.json
