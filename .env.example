# Rodogarcia monorepo
# Modelo legado de desenvolvimento. Prefira .env.development.example e
# .env.development.local ao usar iniciar-dev.bat.

HOST=127.0.0.1
PORT=4012
NODE_ENV=development
FRONTEND_ORIGIN=http://127.0.0.1:5012

# Endereço interno usado pelo Next para proxy/rewrite de /api e /uploads.
BACKEND_INTERNAL_URL=http://127.0.0.1:4012

# CMS separado. CMS_INTERNAL_URL, CMS_BACKEND_INTERNAL_URL e CMS_BACKEND_PROXY_URL
# sao privados; nao use NEXT_PUBLIC_*.
# NEXT_PUBLIC_SITE_URL e publica e usada pelo CMS somente para links e previews do site.
CMS_INTERNAL_URL=http://127.0.0.1:5013
CMS_BACKEND_INTERNAL_URL=http://127.0.0.1:4013
CMS_BACKEND_PROXY_URL=http://127.0.0.1:4013
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:5012

# Endereço público do backend. Variáveis NEXT_PUBLIC_* nunca podem conter segredos.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:4012

# Override opcional para deploy experimental do frontend apontar para outro backend.
# BACKEND_PROXY_URL=https://seu-backend.onrender.com
# Alternativa pública para ambientes onde a URL precisa ser disponibilizada ao frontend.
# Nunca use esta variável para credenciais, tokens ou URLs administrativas internas.
# NEXT_PUBLIC_BACKEND_PROXY_URL=https://api.seudominio.com.br

# Integração opcional com Landing Builder iniciado em fluxo separado. Nunca use NEXT_PUBLIC_* para o token.
# LANDING_BUILDER_API_URL=http://127.0.0.1:6110
# LANDING_BUILDER_SERVICE_TOKEN=altere-para-um-segredo-com-32-caracteres-ou-mais
# Público apenas para o proxy do Next encaminhar rotas desconhecidas ao frontend das landings.
# LANDING_BUILDER_PUBLIC_URL=http://127.0.0.1:5112
# Prefixo público dos assets do Builder; configure o mesmo valor no frontend dele.
# LANDING_BUILDER_ASSET_PREFIX=/landing-assets

# Obrigatorio em producao e no primeiro setup quando nao existir usuario admin.
# Use valor aleatorio, com pelo menos 16 caracteres, e remova placeholders.
ADMIN_SETUP_CODE=altere-para-um-codigo-forte

# Em producao, JWT_SECRET ou SESSION_SECRET deve ter pelo menos 32 caracteres fortes.
# JWT_SECRET tem prioridade quando ambos forem definidos.
# JWT_SECRET=altere-para-um-segredo-jwt-com-32-caracteres-ou-mais
SESSION_SECRET=altere-para-um-segredo-longo

# Em producao, FRONTEND_ORIGIN e CORS_ORIGINS devem usar HTTPS e nao podem apontar
# para localhost/127.0.0.1.
# Origens extras permitidas, separadas por virgula.
# CORS_ORIGINS=https://www.seudominio.com.br,https://seudominio.com.br

# Integração privada com o TMS ESL Cloud. Nunca use NEXT_PUBLIC_* para esta chave.
# GRAPHQL_API_KEY=cole-o-token-bearer-gerado-no-TMS-ESL
# Segredo privado usado para capabilities opacas de validação de NF e manutenção
# de coleta. Obrigatório em produção; não reutilize SESSION_SECRET.
# ESL_OPERATION_SECRET=altere-para-um-segredo-esl-com-32-caracteres-ou-mais
# Opcional: o tenant padrão é rodogarcia e gera https://rodogarcia.eslcloud.com.br/graphql.
# ESL_TENANT=rodogarcia
# Opcional: sobrescreve o endpoint HTTPS GraphQL do ESL para ambiente homologação.
# ESL_GRAPHQL_URL=https://rodogarcia.eslcloud.com.br/graphql

# Overrides opcionais de storage JSON. Caminhos relativos sao resolvidos a
# partir de site/backend; em producao, prefira um volume absoluto fora do repo.
# STORAGE_ROOT=storage
# CONTENT_STORE_PATH=storage/content.json
# SITE_TEXTS_STORE_PATH=storage/site-texts.json
# CONTACTS_STORE_PATH=storage/contacts.json
# QUOTES_STORE_PATH=storage/quotes.json
# POPUP_CONFIG_STORE_PATH=storage/popup-config.json
# POPUP_LEADS_STORE_PATH=storage/popup-leads.json
# USERS_STORE_PATH=storage/private/users.json
# SESSIONS_STORE_PATH=storage/private/sessions.json
# ANALYTICS_STORE_PATH=storage/private/analytics.json
# ANALYTICS_CONFIG_PATH=storage/private/analytics-config.json
# RATE_LIMITS_STORE_PATH=storage/private/rate-limits.json
# UPLOADS_DIR=storage/uploads
