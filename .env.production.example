# Producao Rodogarcia. Copie para .env.production.local na VM e preencha valores reais.
# Nunca versione a copia local, segredos ou o volume de storage.
# O iniciar-prod.bat fixa NODE_ENV=production, HOST=127.0.0.1 e portas 6050/6060.

FRONTEND_ORIGIN=https://site.rodogarcia.com.br
CORS_ORIGINS=https://site.rodogarcia.com.br
TRUST_PROXY=1

# Gere valores aleatorios fortes; nao reutilize os placeholders.
ADMIN_SETUP_CODE=altere-para-um-codigo-forte-com-16-caracteres-ou-mais
SESSION_SECRET=altere-para-um-segredo-longo-com-32-caracteres-ou-mais

# Integração privada do CMS/site com o Landing Builder publicado na mesma infraestrutura.
# LANDING_BUILDER_API_URL=http://127.0.0.1:6110
# LANDING_BUILDER_SERVICE_TOKEN=altere-para-um-segredo-com-32-caracteres-ou-mais
# LANDING_BUILDER_PUBLIC_URL=http://127.0.0.1:6112

# Volume persistente fora do repositorio. Use caminhos absolutos na VM Windows.
STORAGE_ROOT=C:\Rodogarcia\storage-prod
UPLOADS_DIR=C:\Rodogarcia\storage-prod\uploads

# Opcional: origem inicial dos uploads legados ao criar um volume novo.
# Os arquivos ausentes sao copiados sem sobrescrever o volume persistente.
# PRODUCTION_UPLOADS_SEED_DIR=backend\storage\uploads

# Opcional e publico: hostname da API se algum cliente precisar acessa-la diretamente.
# O Next de producao usa BACKEND_INTERNAL_URL local para rewrites de /api e /uploads.
NEXT_PUBLIC_BACKEND_URL=https://sitebackend.rodogarcia.com.br

# Integração privada com o TMS ESL Cloud. A chave é enviada pelo backend como Bearer.
# GRAPHQL_API_KEY=cole-o-token-bearer-gerado-no-TMS-ESL
# ESL_TENANT=rodogarcia
# ESL_GRAPHQL_URL=https://rodogarcia.eslcloud.com.br/graphql
# Opcional: sobrescreve o FFmpeg empacotado pelo backend para converter uploads de vídeo em WebM.
# FFMPEG_PATH=ffmpeg
